---
import welcome from '@/assets/images/welcome.gif';
import Window from '@/components/ui/Window.astro';
import { socials } from '@/data/links';
import Layout from '@/layouts/Layout.astro';

// [indent, key, value]; a "-" key is a list item
const manifest: [number, string, string?][] = [
  [0, 'apiVersion', 'v1'],
  [0, 'kind', 'Engineer'],
  [0, 'metadata'],
  [1, 'name', 'jubayer-ahmad-shovon'],
  [1, 'labels'],
  [2, 'role', 'devops'],
  [2, 'location', 'dhaka-bd'],
  [0, 'spec'],
  [1, 'likes'],
  [2, '-', 'tech'],
  [2, '-', 'anime'],
  [2, '-', 'geeky stuff'],
  [1, 'contact'],
  [2, 'email', 'mail@shovon.me'],
];
---

<Layout title="About :: [.shovon]" description="About Jubayer Ahmad Shovon, a DevOps Engineer from Dhaka, Bangladesh who works with web technologies and loves to build things that make a difference.">
  <section class="py-14 md:py-20">
    <p class="eyebrow motion-safe:animate-rise">// about</p>
    <h1 class="mt-3 font-display text-5xl font-black tracking-tight motion-safe:animate-rise md:text-6xl" style="animation-delay: 60ms">About</h1>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_23rem] lg:gap-14">
      <div class="motion-safe:animate-rise" style="animation-delay: 120ms">
        <p class="font-display text-2xl font-bold tracking-tight">Hello there,</p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Myself <strong class="font-semibold text-fg">Jubayer Ahmad Shovon.</strong>
          <br />
          I work with web technologies and love to build things that make a difference.
          <br />
          Exploring interesting techs and learning along the way having some fun!
        </p>

        <ul class="mt-8 flex flex-wrap gap-3">
          {
            socials.map(({ label, href, icon: Icon }) => (
              <li>
                <a href={href} target="_blank" rel="noopener" title={label} class="btn">
                  <Icon class="text-base" /> {label}
                </a>
              </li>
            ))
          }
        </ul>

        <Window title="welcome.gif" flush class="mt-10 max-w-[30rem]">
          <img src={welcome.src} width={welcome.width} height={welcome.height} alt="Welcome" loading="lazy" decoding="async" class="w-full" />
        </Window>
      </div>

      <div class="motion-safe:animate-rise" style="animation-delay: 200ms">
        <Window title="whoami.yaml">
          <ol>
            {
              manifest.map(([indent, key, value], i) => (
                <li class="flex gap-4">
                  <span class="w-5 shrink-0 select-none text-right text-faint" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span style={`padding-left: ${indent * 2}ch`}>
                    {key === '-' ? <span class="text-faint">- </span> : <Fragment><span class="text-info">{key}</span><span class="text-faint">:</span>{value && ' '}</Fragment>}
                    {value && <span class="text-ok">{value}</span>}
                  </span>
                </li>
              ))
            }
          </ol>
        </Window>
      </div>
    </div>
  </section>
</Layout>
