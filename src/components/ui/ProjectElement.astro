---
import CodeBranch from '@/icons/code-branch.svg';
import Thunderbolt from '@/icons/thunderbolt.svg';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  live: string;
  source: string;
}

const { title, description, image, live, source } = Astro.props;
---

<div class="flex md:flex-row flex-col md:gap-0 gap-3 items-center py-6">
  <Image src={image} width={136} densities={[1, 2]} alt={`${title} Image`} class="mx-8 rounded-md" />
  <div class="dark:text-[#a9a9b3] text-[#222222]">
    <h2 class="md:text-2xl text-xl mb-1">{title}</h2>
    <div class="flex items-center gap-2 mb-4">
      {
        live && (
          <a href={live} class="font-medium rounded-full bg-blue-500 text-white px-3 py-0.5 flex items-center text-sm" target="_blank">
            <Thunderbolt /> Live
          </a>
        )
      }
      <a href={source} class="font-medium rounded-full bg-violet-500 text-white px-3 py-0.5 flex items-center text-sm" target="_blank">
        <CodeBranch /> Source
      </a>
    </div>
    <p>{description}</p>
  </div>
</div>
