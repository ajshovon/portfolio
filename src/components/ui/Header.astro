---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/about', label: 'about' },
  { href: '/projects', label: 'projects' },
];

const pathname = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, '') || '/';
const cwd = pathname === '/' ? '~' : `~${pathname}`;
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-mono text-sm" aria-label="[.shovon] home">
      <span class="text-base font-bold tracking-tight"><span class="text-accent">[</span>.shovon<span class="text-accent">]</span></span>
      <span class="hidden text-muted sm:inline">{cwd}</span>
      <span class="caret" aria-hidden="true"></span>
    </a>

    <nav class="flex items-center font-mono text-sm" aria-label="Main">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={pathname === href ? 'page' : undefined}
            class="relative px-2 py-2 text-muted transition-colors duration-200 after:absolute after:inset-x-2 after:-bottom-[15px] sm:px-3 sm:after:inset-x-3 after:h-0.5 after:bg-accent after:opacity-0 hover:text-fg aria-[current=page]:text-fg aria-[current=page]:after:opacity-100"
          >
            {label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
