---
import CircleHalf from '@/icons/circle-half.svg';
import Moon from '@/icons/moon.svg';
import Sun from '@/icons/sun.svg';
---

<button type="button" class="ml-2 grid size-9 cursor-pointer place-items-center rounded-lg border border-line text-muted transition-colors duration-200 hover:border-accent hover:text-accent" aria-label="Toggle theme" data-theme-toggle>
  <CircleHalf class="[.light_&]:hidden dark:hidden" />
  <Sun class="hidden dark:block" />
  <Moon class="hidden [.light_&]:block" />
</button>
