---
import { socials } from '@/data/links';
import Cat from '@/icons/cat.svg';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-4 px-5 py-8 sm:px-6 font-mono text-xs text-muted sm:flex-row">
    <p>© {year} [.shovon]</p>
    <p class="flex items-center gap-2"><Cat class="text-base text-accent" /> Arigatō Gozaimasu for visiting</p>
    <ul class="flex items-center gap-4 text-lg">
      {
        socials.map(({ label, href, icon: Icon }) => (
          <li>
            <a href={href} target="_blank" rel="noopener" title={label} aria-label={label} class="transition-colors duration-200 hover:text-accent">
              <Icon />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
